{
  "manifest_version": 3,
  "name": "Fpoly Auto Create Video Extension",
  "version": "1.0.0",
  "description": "Chrome Extension for Fpoly Auto Create Video (Google Labs VideoFX automation)",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "scripting",
    "sidePanel",
    "alarms"
  ],
  "host_permissions": [
    "*://labs.google.com/*",
    "*://labs.google/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://labs.google.com/*", "*://labs.google/*"],
      "js": ["src/content.ts"]
    }
  ],
  "action": {
    "default_title": "Open Side Panel"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["ffmpeg/*", "assets/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
